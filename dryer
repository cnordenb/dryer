#!/bin/sh
# Run the duplication finder, creating a local virtualenv on first use.
# A POSIX venv keeps its programs in .venv/bin, a Windows one (Git Bash,
# MSYS) in .venv/Scripts. dryer.cmd does the same from cmd.exe or PowerShell.
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
VENV="$ROOT/.venv"
NEEDS='import sys; sys.exit(sys.version_info < (3, 11))'

# The console script is the last thing pip writes, so its presence means the
# install finished. A venv left behind by a failed install is completed here.
installed() {
  for candidate in "$VENV/bin/dryer" "$VENV/Scripts/dryer.exe"; do
    if [ -x "$candidate" ]; then
      DRYER=$candidate
      return 0
    fi
  done
  return 1
}

venv_python() {
  for candidate in "$VENV/bin/python" "$VENV/Scripts/python.exe"; do
    if [ -x "$candidate" ]; then
      PY=$candidate
      return 0
    fi
  done
  return 1
}

# python3 can be missing on Windows, or be the Microsoft Store stub, which
# fails the version check.
make_venv() {
  for candidate in python3 python; do
    if "$candidate" -c "$NEEDS" >/dev/null 2>&1; then
      "$candidate" -m venv "$VENV"
      return
    fi
  done
  if py -3 -c "$NEEDS" >/dev/null 2>&1; then
    py -3 -m venv "$VENV"
    return
  fi
  echo "dryer: Python 3.11 or newer is required" >&2
  return 1
}

if ! installed; then
  venv_python || { make_venv && venv_python; } || exit 1
  "$PY" -m pip install --disable-pip-version-check -e "$ROOT" || exit 1
  installed || exit 1
fi
exec "$DRYER" "$@"
